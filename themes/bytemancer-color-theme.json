    "editorIndentGuide.activeBackground": "#4A505766",
    "editorRuler.foreground": "#4A505733",

    "editorLineNumber.foreground": "#4A5057",
    "editorLineNumber.activeForeground": "#A485DD",

    "editorBracketMatch.background": "#A485DD33",
    "editorBracketMatch.border": "#A485DD",
    "editorBracketHighlight.foreground1": "#A485DD",
    "editorBracketHighlight.foreground2": "#38A89D",
    "editorBracketHighlight.foreground3": "#7199EE",
    "editorBracketHighlight.foreground4": "#A485DD",
    "editorBracketHighlight.foreground5": "#38A89D",
    "editorBracketHighlight.foreground6": "#7199EE",
    "editorBracketHighlight.unexpectedBracket.foreground": "#EE6D85",

    "editorError.foreground": "#EE6D85",
    "editorWarning.foreground": "#F6955B",
    "editorInfo.foreground": "#7199EE",
    "editorHint.foreground": "#38A89D",

    "editorGutter.addedBackground": "#95C561",
    "editorGutter.modifiedBackground": "#7199EE",
    "editorGutter.deletedBackground": "#EE6D85",

    "editorOverviewRuler.addedForeground": "#95C561",
    "editorOverviewRuler.modifiedForeground": "#7199EE",
    "editorOverviewRuler.deletedForeground": "#EE6D85",
    "editorOverviewRuler.errorForeground": "#EE6D85",
    "editorOverviewRuler.warningForeground": "#F6955B",
    "editorOverviewRuler.infoForeground": "#7199EE",
    "editorOverviewRuler.bracketMatchForeground": "#A485DD",

    "editorWidget.background": "#1A1B2A",
    "editorWidget.foreground": "#b0b0b0",
    "editorWidget.border": "#2b2d45",
    "editorSuggestWidget.background": "#1A1B2A",
    "editorSuggestWidget.foreground": "#b0b0b0",
    "editorSuggestWidget.selectedBackground": "#2b2d45",
    "editorSuggestWidget.highlightForeground": "#D7A65F",

    "peekView.border": "#A485DD",
    "peekViewEditor.background": "#1A1B2A",
    "peekViewEditor.matchHighlightBackground": "#6B533080",
    "peekViewResult.background": "#131313",
    "peekViewResult.fileForeground": "#b0b0b0",
    "peekViewResult.lineForeground": "#b0b0b0",
    "peekViewResult.matchHighlightBackground": "#6B533080",
    "peekViewResult.selectionBackground": "#2b2d45",
    "peekViewResult.selectionForeground": "#e0e2ea",
    "peekViewTitle.background": "#1A1B2A",
    "peekViewTitleDescription.foreground": "#4A5057",
    "peekViewTitleLabel.foreground": "#b0b0b0",

    "diffEditor.insertedTextBackground": "#1a250e80",
    "diffEditor.removedTextBackground": "#2e050d80",
    "diffEditor.diagonalFill": "#2b2d4533",

    "merge.currentHeaderBackground": "#344b1b80",
    "merge.currentContentBackground": "#1a250e80",
    "merge.incomingHeaderBackground": "#2A3A5A80",
    "merge.incomingContentBackground": "#2A3A5A40",

    "panel.background": "#131313",
    "panel.border": "#2b2d45",
    "panelTitle.activeBorder": "#A485DD",
    "panelTitle.activeForeground": "#e0e2ea",
    "panelTitle.inactiveForeground": "#4A5057",

    "statusBar.background": "#1A1B2A",
    "statusBar.foreground": "#b0b0b0",
    "statusBar.border": "#1A1B2A",
    "statusBar.debuggingBackground": "#F6955B",
    "statusBar.debuggingForeground": "#191919",
    "statusBar.noFolderBackground": "#1A1B2A",
    "statusBar.noFolderForeground": "#b0b0b0",
    "statusBarItem.remoteBackground": "#A485DD",
    "statusBarItem.remoteForeground": "#191919",
    "statusBarItem.hoverBackground": "#2b2d45",

    "titleBar.activeBackground": "#131313",
    "titleBar.activeForeground": "#b0b0b0",
    "titleBar.inactiveBackground": "#131313",
    "titleBar.inactiveForeground": "#4A5057",
    "titleBar.border": "#131313",

    "menu.background": "#1A1B2A",
    "menu.foreground": "#b0b0b0",
    "menu.selectionBackground": "#2b2d45",
    "menu.selectionForeground": "#e0e2ea",
    "menu.separatorBackground": "#2b2d45",
    "menubar.selectionBackground": "#2b2d45",

    "notifications.background": "#1A1B2A",
    "notifications.foreground": "#b0b0b0",
    "notifications.border": "#2b2d45",
    "notificationsErrorIcon.foreground": "#EE6D85",
    "notificationsWarningIcon.foreground": "#F6955B",
    "notificationsInfoIcon.foreground": "#7199EE",

    "breadcrumb.foreground": "#4A5057",
    "breadcrumb.focusForeground": "#b0b0b0",
    "breadcrumb.activeSelectionForeground": "#e0e2ea",
    "breadcrumbPicker.background": "#1A1B2A",

    "terminal.background": "#131313",
    "terminal.foreground": "#b0b0b0",
    "terminal.ansiBlack": "#131313",
    "terminal.ansiRed": "#EE6D85",
    "terminal.ansiGreen": "#95C561",
    "terminal.ansiYellow": "#D7A65F",
    "terminal.ansiBlue": "#7199EE",
    "terminal.ansiMagenta": "#A485DD",
    "terminal.ansiCyan": "#38A89D",
    "terminal.ansiWhite": "#e0e2ea",
    "terminal.ansiBrightBlack": "#4A5057",
    "terminal.ansiBrightRed": "#EE6D85",
    "terminal.ansiBrightGreen": "#95C561",
    "terminal.ansiBrightYellow": "#D7A65F",
    "terminal.ansiBrightBlue": "#7199EE",
    "terminal.ansiBrightMagenta": "#A485DD",
    "terminal.ansiBrightCyan": "#38A89D",
    "terminal.ansiBrightWhite": "#e0e2ea",
    "terminal.selectionBackground": "#2b2d45",
    "terminalCursor.foreground": "#A485DD",

    "gitDecoration.addedResourceForeground": "#95C561",
    "gitDecoration.modifiedResourceForeground": "#7199EE",
    "gitDecoration.deletedResourceForeground": "#EE6D85",
    "gitDecoration.untrackedResourceForeground": "#95C561",
    "gitDecoration.conflictingResourceForeground": "#F6955B",
    "gitDecoration.ignoredResourceForeground": "#4A5057",
    "gitDecoration.stageModifiedResourceForeground": "#D7A65F",
    "gitDecoration.stageDeletedResourceForeground": "#EE6D85",

    "debugToolBar.background": "#1A1B2A",
    "debugIcon.breakpointForeground": "#EE6D85",
    "debugIcon.startForeground": "#95C561",
    "debugIcon.pauseForeground": "#D7A65F",
    "debugIcon.stopForeground": "#EE6D85",
    "debugIcon.stepOverForeground": "#7199EE",
    "debugIcon.stepIntoForeground": "#7199EE",
    "debugIcon.stepOutForeground": "#7199EE",
    "debugIcon.restartForeground": "#95C561",

    "editorLightBulb.foreground": "#D7A65F",
    "editorLightBulbAutoFix.foreground": "#95C561"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#4A5057",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#D7A65F"
      }
    },
    {
      "name": "String escape characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#F6955B"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#EE6D85"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.comparison"
      ],
      "settings": {
        "foreground": "#EE6D85"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#95C561"
      }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#b0b0b0"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#7199EE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Type parameters",
      "scope": [
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#7199EE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#b0b0b0"
      }
    },
    {
      "name": "Language variables (this/self/super)",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#A485DD"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#b0b0b0"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.language",
        "constant.other"
      ],
      "settings": {
        "foreground": "#F6955B"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#A485DD"
      }
    },
    {
      "name": "Built-in / Language support",
      "scope": [
        "support.constant",
        "support.variable",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#A485DD"
      }
    },
    {
      "name": "Tag attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#38A89D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comments / docstrings",
      "scope": [
        "string.quoted.docstring",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#D7A65F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.definition.tag",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#b0b0b0"
      }
    },
    {
      "name": "Brackets",
      "scope": [
        "punctuation.bracket",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#b0b0b0"
      }
    },
    {
      "name": "Invalid / Errors",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#EE6D85",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "heading.1.markdown entity.name",
        "heading.2.markdown entity.name",
        "heading.3.markdown entity.name"
      ],
      "settings": {
        "foreground": "#A485DD",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#F6955B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#EE6D85",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#D7A65F"
      }
    },
    {
      "name": "Markdown code block",
      "scope": [
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#D7A65F"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#38A89D"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#95C561"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#EE6D85"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#7199EE"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#38A89D"
      }
    },
    {
      "name": "Decorators / Annotations",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#F6955B"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#95C561"
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#7199EE"
      }
    },
    {
      "name": "CSS property values",
      "scope": [
        "support.constant.property-value.css",
        "meta.property-value.css"
      ],
      "settings": {
        "foreground": "#F6955B"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#7199EE"
      }
    },
    {
      "name": "Template string interpolation",
      "scope": [
        "punctuation.definition.template-expression",
        "string.template meta.template.expression"
      ],
      "settings": {
        "foreground": "#EE6D85"
      }
    },
    {
      "name": "Namespace / Module",
      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#38A89D"
      }
    },
    {
      "name": "Interface",
      "scope": [
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#7199EE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Enum",
      "scope": [
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#b0b0b0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Enum member",
      "scope": [
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#b0b0b0"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#38A89D",
    "type": { "foreground": "#7199EE", "fontStyle": "italic" },
    "class": { "foreground": "#7199EE", "fontStyle": "italic" },
    "interface": { "foreground": "#7199EE", "fontStyle": "italic" },
    "enum": { "foreground": "#b0b0b0", "fontStyle": "italic" },
    "enumMember": "#b0b0b0",
    "function": "#95C561",
    "method": "#95C561",
    "macro": "#A485DD",
    "variable": "#b0b0b0",
    "variable.readonly": "#b0b0b0",
    "variable.defaultLibrary": "#A485DD",
    "parameter": "#b0b0b0",
    "property": "#b0b0b0",
    "property.readonly": "#b0b0b0",
    "keyword": "#EE6D85",
    "comment": { "foreground": "#4A5057", "fontStyle": "italic" },
    "string": "#D7A65F",
    "number": "#A485DD",
    "operator": "#EE6D85",
    "decorator": "#F6955B",
    "typeParameter": { "foreground": "#7199EE", "fontStyle": "italic" }
  }
}
