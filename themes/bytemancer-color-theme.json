    "editor.background": "#191919",
    "editor.foreground": "#b0b0b0",
    "editorCursor.foreground": "#A485DD",
    "editor.selectionBackground": "#2b2d45",
    "editor.selectionHighlightBackground": "#2b2d4566",
    "editor.inactiveSelectionBackground": "#2b2d4580",
    "editor.wordHighlightBackground": "#2b2d4566",
    "editor.wordHighlightStrongBackground": "#2b2d4599",
    "editor.findMatchBackground": "#6B5330",
